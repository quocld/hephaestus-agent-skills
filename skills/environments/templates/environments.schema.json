{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environments.schema.json",
  "title": "Project environment registry",
  "description": "Committed file. Holds no secret values: every secret is a reference resolved at the moment of use.",
  "type": "object",
  "required": [
    "project",
    "defaultEnvironment",
    "environments"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "defaultEnvironment": {
      "type": "string",
      "minLength": 1
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/environment"
      }
    }
  },
  "$defs": {
    "secretRef": {
      "type": "object",
      "required": [
        "secret"
      ],
      "additionalProperties": false,
      "properties": {
        "secret": {
          "description": "env:NAME (shell env or gitignored .agents/secrets.env) or op://vault/item/field (1Password CLI).",
          "type": "string",
          "pattern": "^(env:[A-Z][A-Z0-9_]*|op://.+)$"
        }
      }
    },
    "secretLikeKeys": {
      "description": "Any key that looks like a secret must be a secretRef, never a literal.",
      "type": "object",
      "patternProperties": {
        "([Pp]assword|[Tt]oken|[Ss]ecret|[Kk]ey|[Dd]b[Uu]rl|[Cc]onnection[Ss]tring)$": {
          "$ref": "#/$defs/secretRef"
        }
      }
    },
    "commandList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "policy",
        "services"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "branch": {
          "description": "Git branch this environment deploys from.",
          "type": "string"
        },
        "policy": {
          "description": "autonomous: act and report. confirm-writes: one confirmation for the whole write plan. confirm-each-step: every write step confirmed separately.",
          "enum": [
            "autonomous",
            "confirm-writes",
            "confirm-each-step"
          ]
        },
        "allowedWithoutAsking": {
          "description": "Registry commands (all read-only) that skip confirmation under confirm-each-step.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "version",
              "logs",
              "verify"
            ]
          }
        },
        "rules": {
          "description": "Free-text rules for this environment, applied on top of the policy when stricter.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "testDataAllowed"
          ],
          "properties": {
            "testDataAllowed": {
              "description": "Kill switch. false: never create, modify, or delete records here outside reviewed migrations shipped through the deploy protocol, even when asked in chat.",
              "type": "boolean"
            },
            "testDataMarker": {
              "description": "Prefix put on every record an agent creates, so it can be found and deleted.",
              "type": "string"
            }
          }
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "deployOrder": {
          "description": "Service names in deploy order. Default when absent: db before web, which requires backward-compatible migrations.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "local",
            "vps",
            "vercel",
            "supabase",
            "docker-compose",
            "custom"
          ]
        },
        "runtime": {
          "description": "Free text, e.g. \"Next.js 15 + pm2\".",
          "type": "string"
        },
        "access": {
          "type": "object",
          "$ref": "#/$defs/secretLikeKeys",
          "properties": {
            "ssh": {
              "description": "Host alias defined in ~/.ssh/config. Never a raw IP plus key path.",
              "type": "string"
            },
            "appDir": {
              "type": "string"
            },
            "processName": {
              "type": "string"
            },
            "supabaseProjectRef": {
              "type": "string"
            },
            "dashboardUrl": {
              "type": "string"
            },
            "vercelProjectId": {
              "description": "projectId from .vercel/project.json.",
              "type": "string"
            },
            "vercelOrgId": {
              "description": "orgId from .vercel/project.json.",
              "type": "string"
            }
          }
        },
        "version": {
          "description": "Prints exactly one value and nothing else: the commit SHA the running process was built from, or for a database the latest applied migration version.",
          "type": "string"
        },
        "deploy": {
          "description": "Ordered steps. Under confirm-each-step, each item is one confirmed step.",
          "$ref": "#/$defs/commandList"
        },
        "verify": {
          "$ref": "#/$defs/commandList",
          "description": "Read-only checks."
        },
        "rollback": {
          "$ref": "#/$defs/commandList"
        },
        "logs": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "account": {
      "type": "object",
      "required": [
        "role",
        "login"
      ],
      "$ref": "#/$defs/secretLikeKeys",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "login": {
          "description": "Email or username. Not a secret.",
          "type": "string"
        },
        "password": {
          "$ref": "#/$defs/secretRef"
        },
        "mfa": {
          "description": "How to get the second factor, e.g. a TOTP secretRef or \"ask the user\".",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/secretRef"
            }
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
